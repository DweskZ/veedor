# Template for the server env file. This file is NOT an env file and holds no secret.
#
# On the server:
#   sudo install -d -m 700 /etc/veedor
#   sudo cp server.env.template /etc/veedor/server.env && sudo chmod 600 /etc/veedor/server.env
#   sudo vi /etc/veedor/server.env      # replace every CHANGE_ME
# Generate a password with:  openssl rand -base64 24 | tr -d '/+=' 
# The file must be owned by root with mode 600 (the installer enforces it). Never commit the filled-in file.
# Compose reads it with --env-file.

# --- required -----------------------------------------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME

# Address Caddy serves.
#   no domain (temporary, HTTP only):  SITE_ADDRESS=:80
#   with a domain (automatic HTTPS):   SITE_ADDRESS=veedor.example.org
SITE_ADDRESS=:80

# The exact public origin, no trailing slash: http://<elastic-ip> or https://veedor.example.org.
# It is used for CORS. The web image was built with the same value (build-release.sh --site-url).
PUBLIC_ORIGIN=http://CHANGE_ME_ELASTIC_IP

# --- paths and images (defaults are right for the Terraform-built server) ---------------------------
VEEDOR_DATA_HOST=/srv/veedor/data
VEEDOR_API_IMAGE=veedor-api:release
VEEDOR_WEB_IMAGE=veedor-web:release

# --- sizing (t4g.small defaults; raise on t4g.medium) -----------------------------------------------
# DB_MEM_LIMIT=768m
# API_MEM_LIMIT=768m
# WEB_MEM_LIMIT=320m
# PG_SHARED_BUFFERS=128MB
# VEEDOR_API_WORKERS=1   # 2 needs API_MEM_LIMIT=1280m or more (two workers were OOM-killed at 768m)
# VEEDOR_LAKE_THREADS=2

# --- question answering (recommended: on, model mode with a daily cap) -----------------------------
# Needs data/models/fastembed on the server (build-release.sh --with-ask-model).
# With provider, model and key set, a language model only selects which stored facts answer the
# question (it never writes text); measured on 2026-11-17 with gpt-5.4-mini (docs/EVALUATION.md).
# When the daily budget is spent, or the provider fails, the route answers by retrieval and costs
# nothing. Without provider, model and key it always answers by retrieval.
# Create a NEW key for the server with a spending limit at the provider; never reuse a key that was
# pasted into a chat, a ticket or a commit.
VEEDOR_ASK_ENABLED=true
VEEDOR_ASK_DAILY_BUDGET=300
VEEDOR_LLM_PROVIDER=openai
VEEDOR_LLM_MODEL=gpt-5.4-mini
VEEDOR_LLM_API_KEY=

# --- third-party quotes (OFF; leave commented) ---------------------------------------------------
# WARNING: quotes are text written by third parties and the review found named persons in them. Do NOT
# enable quotes in production until the privacy gate (scripts/check_quotes_privacy.py) passes and the
# disclosure is in place (docs/DEPLOYMENT_AWS.md, pre-publication checklist). With quotes off the ask
# route attaches no quotes. The release only contains the quotes tables if it was built with
# build-release.sh --with-quotes. Default: false.
# VEEDOR_QUOTES_ENABLED=false

# --- observability (optional: add -f compose.observability.yml, VEEDOR_OBSERVABILITY=1; needs t4g.medium) ---
# Without a password the stack refuses to start. Grafana is on the server's loopback only (Session Manager port forward).
# GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# VEEDOR_OTEL_ENDPOINT=http://observability:4318
