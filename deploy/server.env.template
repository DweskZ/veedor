# Template for the server env file. This file is NOT an env file and holds no secret.
#
# On the server:
#   sudo install -d -m 700 /etc/veedor
#   sudo cp server.env.template /etc/veedor/server.env && sudo chmod 600 /etc/veedor/server.env
#   sudo vi /etc/veedor/server.env      # replace every CHANGE_ME
# Generate a password with:  openssl rand -base64 24 | tr -d '/+=' 
# Never commit the filled-in file. Compose reads it with --env-file.

# --- required -----------------------------------------------------------------------------------
POSTGRES_PASSWORD=CHANGE_ME

# Address Caddy serves.
#   no domain (temporary, HTTP only):  SITE_ADDRESS=:80
#   with a domain (automatic HTTPS):   SITE_ADDRESS=veedor.example.org
SITE_ADDRESS=:80

# The exact public origin, no trailing slash: http://<elastic-ip> or https://veedor.example.org.
# It is used for CORS. The web image was built with the same value (build-release.sh --site-url).
PUBLIC_ORIGIN=http://CHANGE_ME_ELASTIC_IP

# --- paths and images (defaults are right for the Terraform-built server) ---------------------------
VEEDOR_DATA_HOST=/srv/veedor/data
VEEDOR_API_IMAGE=veedor-api:release
VEEDOR_WEB_IMAGE=veedor-web:release

# --- sizing (t4g.small defaults; raise on t4g.medium) -----------------------------------------------
# DB_MEM_LIMIT=768m
# API_MEM_LIMIT=768m
# WEB_MEM_LIMIT=320m
# PG_SHARED_BUFFERS=128MB
# VEEDOR_API_WORKERS=2
# VEEDOR_LAKE_THREADS=2

# --- question answering (off by default; read docs/DEPLOYMENT_AWS.md first) -----------------------
# Needs data/models/fastembed on the server (build-release.sh --with-ask-model). Without a provider,
# model and key the route answers by retrieval only and costs nothing.
# VEEDOR_ASK_ENABLED=true
# VEEDOR_ASK_DAILY_BUDGET=300
# VEEDOR_LLM_PROVIDER=
# VEEDOR_LLM_MODEL=
# VEEDOR_LLM_API_KEY=

# --- observability (optional compose profile; needs t4g.medium) -----------------------------------
# GRAFANA_ADMIN_PASSWORD=CHANGE_ME
# VEEDOR_OTEL_ENDPOINT=http://observability:4318
