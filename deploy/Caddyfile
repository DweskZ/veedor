# Veedor reverse proxy (Caddy 2.x, no plugins). One origin: /api/* -> api, everything else -> web.
#
# SITE_ADDRESS (server env file):
#   veedor.example.org  automatic HTTPS (Let's Encrypt / ZeroSSL), HTTP redirected to HTTPS
#   :80                 plain HTTP on any host name or IP. TEMPORARY: no certificate is possible for a
#                       bare IP with the default certificate authorities, and traffic is unencrypted.
#
# Headers: the web app already sends CSP, X-Frame-Options, X-Content-Type-Options, Referrer-Policy and
# Permissions-Policy (web/next.config.ts); the API sends nosniff, X-Frame-Options, Referrer-Policy,
# Cache-Control and a CSP on its own responses (src/veedor/api/security.py). Caddy therefore adds only
# what neither sends: HSTS (HTTPS only) and it removes the Server header. Do not add the others here:
# Caddy's `header` would append a duplicate.
#
# HTTP caching: the API sets ETag, Cache-Control and Vary: Origin per route class (docs/SECURITY.md).
# Caddy has no cache module here and does not touch them: `reverse_proxy` forwards them and `encode`
# only compresses the body (the API's ETags are weak, so a compressed copy stays interchangeable).
# Do not add `header -ETag` or a Cache-Control override here.
#
# Not possible without a plugin: request rate limiting (third-party module caddy-ratelimit; needs a
# custom Caddy build). The API limits anonymous reads per client IP in memory (docs/SECURITY.md).

{
	admin off
	# HTTP/1.1 and HTTP/2 only: no UDP/443 to open.
	servers {
		protocols h1 h2
		# Client address and forwarding headers. Caddy 2.11 (image caddy:2.11-alpine, v2.11.9 when this
		# was written): with no trusted proxies (the default, written out here), reverse_proxy IGNORES any
		# client-supplied X-Forwarded-For/-Proto/-Host and sets them itself from the TCP peer. Nothing sits
		# in front of Caddy (no CDN, no load balancer): do NOT add trusted ranges, or a client behind them
		# could choose its own address and defeat the API's per-client limits. If a CDN is ever put in front,
		# list only that CDN's published ranges here AND change FORWARDED_ALLOW_IPS reasoning in
		# compose.prod.yml. Docs: https://caddyserver.com/docs/caddyfile/options#trusted-proxies
		trusted_proxies static
	}
	log {
		output stdout
		format json
		level INFO
	}
}

# Internal health listener for the container healthcheck. Not published by compose.
:8081 {
	bind 127.0.0.1
	respond /healthz 200
	log {
		output discard
	}
}

{$SITE_ADDRESS::80} {
	encode zstd gzip

	# The API accepts 16 KiB bodies at most (MAX_BODY_BYTES); nothing here needs more.
	request_body {
		max_size 32KB
	}

	header {
		-Server
	}
	@secure protocol https
	header @secure Strict-Transport-Security "max-age=31536000"

	# Access log: no query strings (search terms), client address truncated, no cookies/auth.
	log {
		output stdout
		format filter {
			wrap json
			request>uri regexp \?.*$ ""
			request>remote_ip ip_mask 24 48
			request>client_ip ip_mask 24 48
			request>headers delete
		}
	}

	handle /api/* {
		reverse_proxy api:8000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 60s
			}
		}
	}

	handle {
		reverse_proxy web:3000 {
			# web forwards the visitor address it reads here to the API, which trusts it. Set it explicitly
			# (replacing any client-supplied value) instead of relying only on the default behaviour above.
			header_up X-Forwarded-For {remote_host}
			transport http {
				dial_timeout 5s
				response_header_timeout 60s
			}
		}
	}
}
