{
  "uid": "veedor",
  "title": "Veedor",
  "tags": [
    "veedor"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "API (RED)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate by route",
      "description": "How much traffic does each route receive? (requests per second, route template)",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{http_route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Errors by route and status class",
      "description": "Which routes fail? Server errors (5xx) and client errors (4xx) per second.",
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "5xx {{http_route}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{http_response_status_code=~\"4..\"}[$__rate_interval]))",
          "legendFormat": "4xx {{http_route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency p50 / p95 by route",
      "description": "How slow are requests? Median and 95th percentile per route template.",
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{http_route}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(http_server_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{http_route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "type": "row",
      "title": "Investigations",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Investigations by final mode",
      "description": "How many investigations finished, and in which mode (template or llm)? (cumulative counter, latest value in the selected range)",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (final_mode) (last_over_time(veedor_investigations_total[$__range]))",
          "legendFormat": "{{final_mode}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "type": "bargauge",
      "title": "Specialist runs",
      "description": "Which specialist agents ran, and how often? (cumulative counter, latest value in the selected range)",
      "gridPos": {
        "x": 6,
        "y": 10,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (specialist) (last_over_time(veedor_specialist_runs_total[$__range]))",
          "legendFormat": "{{specialist}}"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "type": "barchart",
      "title": "Tool-call outcomes by tool",
      "description": "Which tools succeed (ok) and which time out or hit upstream errors? (cumulative counter, latest value in the selected range)",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (tool, outcome) (last_over_time(veedor_tool_calls_total[$__range]))",
          "legendFormat": "{{tool}} / {{outcome}}",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "xField": "tool",
        "stacking": "normal"
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Tools, tokens and grounding",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Tool latency p50 / p95 by tool",
      "description": "How long do external lookups take? Median and 95th percentile per tool.",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 10,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le, tool) (rate(veedor_tool_duration_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{tool}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, tool) (rate(veedor_tool_duration_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{tool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Tokens per investigation",
      "description": "How many model tokens does one investigation cost on average? (cumulative counters; empty when no model is used)",
      "gridPos": {
        "x": 10,
        "y": 19,
        "w": 7,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(last_over_time(veedor_llm_tokens_total[$__range])) / sum(last_over_time(veedor_investigations_total[$__range]))",
          "legendFormat": "tokens"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "no LLM usage",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 12,
      "type": "gauge",
      "title": "Grounding pass rate",
      "description": "What share of generated text passed the grounding verifier? (cumulative counter, latest value in the selected range)",
      "gridPos": {
        "x": 17,
        "y": 19,
        "w": 7,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(last_over_time(veedor_grounding_results_total{passed=\"true\"}[$__range])) / sum(last_over_time(veedor_grounding_results_total[$__range]))",
          "legendFormat": "pass rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "type": "row",
      "title": "Traces",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 14,
      "type": "table",
      "title": "Recent traces (Tempo)",
      "description": "Latest request and investigation traces; open one to see its spans.",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"veedor.*\" }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    }
  ]
}
