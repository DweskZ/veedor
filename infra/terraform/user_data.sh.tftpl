#!/bin/bash
# First-boot setup for the Veedor server (Amazon Linux 2023, arm64). No secrets here: the server env
# file is created by the owner afterwards (deploy/server.env.template). Log: /var/log/veedor-init.log
set -euxo pipefail
exec > >(tee -a /var/log/veedor-init.log) 2>&1

dnf install -y docker zstd
install -d /etc/docker
cat > /etc/docker/daemon.json <<'JSON'
{ "log-driver": "json-file", "log-opts": { "max-size": "10m", "max-file": "3" } }
JSON
systemctl enable --now docker

# Docker Compose v2 plugin, pinned release and checksum (docker/compose v5.7.1, linux-aarch64).
COMPOSE_VERSION=v5.7.1
COMPOSE_SHA256=f2f49f903240895fa764c0dca3a14548b754ad9426f6b609ccaf55ec5a3aa2a5
install -d /usr/local/lib/docker/cli-plugins
curl -fsSL -o /usr/local/lib/docker/cli-plugins/docker-compose \
  "https://github.com/docker/compose/releases/download/$${COMPOSE_VERSION}/docker-compose-linux-aarch64"
echo "$${COMPOSE_SHA256}  /usr/local/lib/docker/cli-plugins/docker-compose" | sha256sum -c -
chmod 755 /usr/local/lib/docker/cli-plugins/docker-compose

%{ if swap_gb > 0 ~}
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=${swap_gb * 1024} status=none
  chmod 600 /swapfile
  mkswap /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi
swapon -a
sysctl -w vm.swappiness=10
echo 'vm.swappiness=10' > /etc/sysctl.d/90-veedor.conf
%{ endif ~}

install -d -m 755 /srv/veedor /srv/veedor/release /srv/veedor/backups
install -d -m 700 /etc/veedor

systemctl enable --now amazon-ssm-agent || true
echo "veedor init finished $(date -u +%FT%TZ)"
